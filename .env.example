# Handwritten OCR Configuration

# Offline mode (true after model is downloaded)
OFFLINE_MODE=true

# Model path (relative to project root)
# MODEL_PATH=models/trocr-large-handwritten

# Image size limits
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096

# Low memory mode
LOW_MEMORY_MODE=false

# Generation parameters
MAX_NEW_TOKENS=200
NUM_BEAMS=1
LENGTH_PENALTY=1.0
EARLY_STOPPING=true

# Preprocessing
# DEFAULT_PREPROCESSING=light

# Mark unclear text
MARK_UNCLEAR=true

# Logging
LOG_LEVEL=INFO
LOG_CONTENT=false

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evaluation

# Authentication Configuration
SECRET_KEY=generate_a_secure_random_string_here_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
